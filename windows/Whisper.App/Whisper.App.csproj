<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Whisper.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      Framework-dependent WindowsAppSDK deployment (the default/standard way to ship
      WinUI3 apps). Self-contained WindowsAppSDK deployment was shipping without the
      reg-free WinRT activation manifest entries this WindowsAppSDK version needs,
      causing a 0xc000027b STATUS_STOWED_EXCEPTION crash in Microsoft.UI.Xaml.dll on
      every launch (confirmed via CI: mt.exe dump of the embedded manifest had zero
      activatableClass/ui.xaml entries). Framework-dependent relies on the Windows App
      Runtime being installed on the machine (see Installer/Package.wxs, which bundles
      and silently installs the official redistributable) plus the WindowsPackageType=None
      automatic bootstrapper support for unpackaged apps (see Microsoft's "Windows App SDK
      deployment guide for framework-dependent apps packaged with external location or
      unpackaged").
      Note: this is independent of .NET's own SelfContained (dotnet publish "self
      contained" flag) publish setting, which stays true (see release.yml) so the app
      still carries its own .NET 8 CLR and doesn't need a separate .NET Desktop Runtime
      prerequisite. Only the Windows App Runtime is an added install-time dependency.
    -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Version>0.0.0</Version>
    <!--
      Own Main() (Program.cs) instead of the XAML-compiler-generated one: a failure
      inside Microsoft.UI.Xaml.dll's Application.Start() itself is a native fail-fast
      (STATUS_STOWED_EXCEPTION / 0xc000027b, confirmed via dotnet-dump clrstack on a
      real repro, see issue #1) that terminates the process before App()'s
      constructor, InitializeComponent(), or any of its exception handlers ever run.
      It bypasses managed SEH by design and can't be caught in-process. The only thing
      reachable before that fail-fast is whatever runs earlier in Main() itself, so
      that's where a best-effort startup diagnostic (Program.WriteStartupDiagnostics)
      has to live; it can't be moved into App() because App() may never be reached.
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whisper.Core\Whisper.Core.csproj" />
  </ItemGroup>

</Project>
